# Fit Odyssey — Project Root Environment Configuration Example

# Local Supabase Ports & Keys
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_dev
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_SERVER_ONLY

# Database Direct Connection (for migrations/pgTAP if connecting directly)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# IMPORTANT:
# 1. SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the server / Edge Function runtime.
# 2. NEVER include the service_role key in mobile/ or web/ bundles.
